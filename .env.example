# =============================================================
# MikroSaaS — PostgreSQL Environment
# =============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#   nano .env
#
# .env is already in .gitignore — it will NOT be committed.
# =============================================================

# PostgreSQL
POSTGRES_USER=mikrosaas
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=mikrosaas
POSTGRES_PORT=5432

# JWT (for future app container)
# JWT_SECRET=<generate-a-jwt-secret>

# App (for future app container)
# APP_ENV=development
# APP_PORT=8080
